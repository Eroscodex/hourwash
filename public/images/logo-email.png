<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
    <circle cx="100" cy="100" r="96" fill="#FFFFFF" stroke="#0F172A" stroke-width="6"/>
    <circle cx="100" cy="100" r="90" fill="none" stroke="#0F172A" stroke-width="3"/>
    
    <!-- Washing Machine Body -->
    <rect x="75" y="45" width="50" height="60" rx="4" fill="#FFFFFF" stroke="#0F172A" stroke-width="3"/>
    <rect x="75" y="45" width="50" height="14" fill="#0F172A"/>
    <rect x="106" y="50" width="12" height="4" rx="1" fill="#FFFFFF"/>
    <circle cx="100" cy="78" r="16" fill="#FFFFFF" stroke="#0F172A" stroke-width="3"/>
    <circle cx="100" cy="78" r="10" fill="#0F172A"/>
    
    <!-- Soap Bubbles -->
    <circle cx="56" cy="62" r="5" fill="none" stroke="#0F172A" stroke-width="2"/>
    <circle cx="66" cy="54" r="7" fill="none" stroke="#0F172A" stroke-width="2"/>
    <circle cx="56" cy="94" r="10" fill="none" stroke="#0F172A" stroke-width="2"/>
    <circle cx="68" cy="106" r="6" fill="none" stroke="#0F172A" stroke-width="2"/>
    <circle cx="140" cy="94" r="9" fill="none" stroke="#0F172A" stroke-width="2"/>
    <circle cx="152" cy="102" r="5" fill="none" stroke="#0F172A" stroke-width="2"/>
    
    <!-- HOUR WASH Text & Clock Icon -->
    <text x="100" y="142" font-family="'Outfit', 'Inter', sans-serif" font-size="19" font-weight="900" text-anchor="middle" fill="#0F172A" letter-spacing="1">HOUR WASH</text>
</svg>
